# --- database ---------------------------------------------------------
# SQLite (local quick start) — live.db 已有历史数据
DATABASE_URL=sqlite+aiosqlite:///./live.db

# --- external AI providers (Phase 12) ---------------------------------
# Leave WINDUP_BASE_URL empty to run the deterministic offline mock.
WINDUP_BASE_URL=
WINDUP_API_KEY=
WINDUP_STYLE=anime

# --- engine tuning (Phase 13-15) ---------------------------------------
DEFAULT_FPS=12
FRAME_COUNT=8
FRAME_SIZE=128
DNA_MATCH_THRESHOLD=0.85
HITBOX_EXPAND_RADIUS=8
ENGINE_TARGET=cocos
