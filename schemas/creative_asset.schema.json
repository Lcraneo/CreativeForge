  "title": "CreativeAsset",
  "type": "object",
  "required": [
    "identity",
    "source",
    "content",
    "version",
    "provenance"
  ],
  "properties": {
    "identity": {
      "$ref": "./identity.schema.json"
    },
    "source": {
      "$ref": "./source.schema.json"
    },
    "content": {
      "$ref": "./content.schema.json"
    },
    "visual": {
      "$ref": "./visual.schema.json"
