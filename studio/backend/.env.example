# Optional model provider configuration. Leave disabled for deterministic local generation.
MODEL_ENABLED=false
MODEL_PROVIDER=
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
MODEL_CHAT_MODEL=

# ── 安全（studio/backend/security.py）──────────────────────────────
# 设置后 /api 与 /ws 全部要求令牌（Authorization: Bearer、cookie studio_token
# 或 ?token= 均可）。留空 = 本地开发模式，不启用鉴权。
STUDIO_AUTH_TOKEN=
# CORS 白名单（逗号分隔）。默认仅本机 5173/8600。
STUDIO_CORS_ORIGINS=
# 每分钟每 IP 的写请求上限，0 = 关闭限流。默认 120。
STUDIO_RATE_LIMIT=120

# ── 产物对象存储（artifact_store.py）─────────────────────────────────
# 托管容器（Render 等）没有持久盘，重新部署会清空 generated/、data/ 与
# history.json。配置下面任意一组凭证后，产物与索引会自动同步到云端，
# 读取时本地缺失则回源——URL 保持 /api/generated/... 不变。
# 未配置时本模块全部 no-op，行为与改造前一致。
#
# 七牛云 Kodo（推荐，S3 兼容端点）
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET_NAME=
QINIU_REGION=cn-east-1
#
# 通用前缀（六厂商均可，provider 取 oss/cos/kodo/obs/tos/bos）
STORAGE_PROVIDER=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ENDPOINT=
#
# 关闭后台增量上传（排查问题时用；读取回源不受影响）
CF_ARTIFACT_SYNC=

