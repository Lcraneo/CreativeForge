# Optional model provider configuration. Leave disabled for deterministic local generation.
MODEL_ENABLED=false
MODEL_PROVIDER=
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
MODEL_CHAT_MODEL=

# ── 安全（studio/backend/security.py）──────────────────────────────
# 设置后 /api 与 /ws 全部要求令牌（Authorization: Bearer、cookie studio_token
# 或 ?token= 均可）。留空 = 本地开发模式，不启用鉴权。
STUDIO_AUTH_TOKEN=
# CORS 白名单（逗号分隔）。默认仅本机 5173/8600。
STUDIO_CORS_ORIGINS=
# 每分钟每 IP 的写请求上限，0 = 关闭限流。默认 120。
STUDIO_RATE_LIMIT=120

